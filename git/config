[core]
	quotepath  = false
	editor     = vim
[init]
	defaultBranch = main
[user]
	useConfigOnly = true
[credential]
	helper = cache --timeout=86400
[ghq]
	root = ~/ghq
[include]
	path = local.gitconfig
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
